<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Mac App Store builds must be sandboxed. Start minimal; add
       com.apple.security.files.user-selected.read-only only if the per-app
       "Add an App…" picker survives the sandbox spike. -->
  <key>com.apple.security.app-sandbox</key>
  <true/>
</dict>
</plist>
